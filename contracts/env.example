# [주의] 이 파일은 예시입니다. 실제 값이 들어간 contracts/.env 파일은 절대 커밋하지 마세요.
#
# ----------------------------
# Hardhat - Sepolia 설정
# ----------------------------
# 예: https://sepolia.infura.io/v3/<KEY> 또는 https://eth-sepolia.g.alchemy.com/v2/<KEY>
SEPOLIA_RPC_URL=

# 배포 지갑 private key (0x로 시작). 절대 커밋 금지.
PRIVATE_KEY=0x

# 선택: CLI에 --network sepolia 를 매번 주기 싫으면 사용
HARDHAT_NETWORK=sepolia

# 배포된 WETH 컨트랙트 주소 (deploy 로그의 "WETH deployed to:" 값)
WETH_ADDRESS=


